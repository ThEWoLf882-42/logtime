  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
